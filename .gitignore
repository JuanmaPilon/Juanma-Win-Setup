# Local environment backups
backups/*.json
backups/*.reg
backups/*.bak
backups/*.log

# Temporary or machine-specific artifacts
*.tmp
*.temp
*.log

# PowerShell local transient files
*.ps1~

# Optional local secrets or user-specific state
secrets/
private-configs/
*.pem
*.key
*.pfx

# PowerToys telemetry and runtime state files
configs/powertoys/**/settings-telemetry.json
configs/powertoys/**/log_settings.json
configs/powertoys/**/last_version_run.json
configs/powertoys/**/UpdateState.json
configs/powertoys/**/oobe_settings.json

# Keep public configs folder code-only; sensitive exports go to private-configs/
configs/powertoys/**
!configs/powertoys/import.ps1
!configs/powertoys/README.md
configs/startallback/**
!configs/startallback/import.ps1
!configs/startallback/README.md
configs/windows-ui/**
!configs/windows-ui/import.ps1
!configs/windows-ui/README.md
configs/startup/**
!configs/startup/import.ps1
!configs/startup/README.md
configs/git/**
!configs/git/import.ps1
!configs/git/README.md
# Manual installers stay local; only the list is versioned
configs/manual-installs/*
!configs/manual-installs/README.md
configs/terminal/**
!configs/terminal/import.ps1
!configs/terminal/README.md
